<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgPortada"
        android:layout_width="72dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/desc_portada"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toTopOf="@id/imgPortada"
        app:layout_constraintStart_toEndOf="@id/imgPortada"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Revista de Ciencias Sociales y Económicas" />

    <TextView
        android:id="@+id/tvAbreviatura"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/uteq_green"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvNombre"
        app:layout_constraintStart_toEndOf="@id/imgPortada"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="RCSE" />

    <TextView
        android:id="@+id/tvFlecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="28sp"
        android:textColor="@color/uteq_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
